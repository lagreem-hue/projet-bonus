    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "prisma": "^5.7.0",
    "@prisma/client": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "express-validator": "^7.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "@faker-js/faker": "^8.3.1",
    "multer": "^1.4.5-lts.1",
    "aws-sdk": "^2.1506.0",
    "morgan": "^1.10.0",
    "helmet": "^7.1.0",
    "cookie-parser": "^1.4.6",
    "socket.io": "^4.6.1",
    "nodemailer": "^6.9.7",
