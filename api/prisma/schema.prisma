generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. USERS - Table principale
// ==========================================
model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique @db.VarChar(255)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  firstName        String    @map("first_name") @db.VarChar(100)
  lastName         String    @map("last_name") @db.VarChar(100)
  phone            String?   @db.VarChar(20)
  profilePicture   String?   @map("profile_picture") @db.VarChar(255)

  // Rôles multiples
  isGuest          Boolean   @default(true) @map("is_guest")
  isHost           Boolean   @default(false) @map("is_host")
  isAdmin          Boolean   @default(false) @map("is_admin")

  // Vérification
  emailVerified    Boolean   @default(false) @map("email_verified")
  phoneVerified    Boolean   @default(false) @map("phone_verified")

  // Dates (TIMESTAMPTZ)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)

  // Relations
  guestProfile     GuestProfile?
  hostProfile      HostProfile?
  adminProfile     AdminProfile?
  properties       Property[]
  bookings         Booking[]
  reviews          Review[]
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  favorites        Favorite[]

  @@index([email])
  @@index([isGuest, isHost, isAdmin])
  @@map("users")
}

// ==========================================
// 2. GUEST_PROFILES
// ==========================================
model GuestProfile {
  userId              Int      @id @map("user_id")
  preferredLanguage   String   @default("fr") @map("preferred_language") @db.VarChar(10)
  loyaltyPoints       Int      @default(0) @map("loyalty_points")
  totalBookings       Int      @default(0) @map("total_bookings")
  bio                 String?  @db.VarChar(500)
  dateOfBirth         DateTime? @map("date_of_birth") @db.Date
  governmentIdVerified Boolean @default(false) @map("government_id_verified")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("guest_profiles")
}

// ==========================================
// 3. HOST_PROFILES
// ==========================================
model HostProfile {
  userId              Int      @id @map("user_id")
  isSuperhost         Boolean  @default(false) @map("is_superhost")
  responseRate        Decimal  @default(0.00) @map("response_rate") @db.Decimal(5, 2)
  responseTimeHours   Int?     @map("response_time_hours")
  totalListings       Int      @default(0) @map("total_listings")
  averageRating       Decimal? @map("average_rating") @db.Decimal(3, 2)
  taxId               String?  @map("tax_id") @db.VarChar(50)
  bankAccountVerified Boolean  @default(false) @map("bank_account_verified")
  hostSince           DateTime @default(now()) @map("host_since") @db.Date
  bio                 String?  @db.VarChar(500)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("host_profiles")
}

// ==========================================
// 4. ADMIN_PROFILES
// ==========================================
model AdminProfile {
  userId       Int      @id @map("user_id")
  adminLevel   String   @map("admin_level") @db.VarChar(20)
  permissions  Json     @default("{}") @db.JsonB
  lastAction   DateTime? @map("last_action") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_profiles")
}

// ==========================================
// 5. PROPERTIES
// ==========================================
model Property {
  id              Int       @id @default(autoincrement())
  hostId          Int       @map("host_id")
  title           String    @db.VarChar(255)
  description     String    @db.Text
  propertyType    String    @map("property_type") @db.VarChar(50)
  address         String    @db.VarChar(255)
  city            String    @db.VarChar(100)
  country         String    @db.VarChar(100)
  postalCode      String?   @map("postal_code") @db.VarChar(20)
  latitude        Decimal?  @db.Decimal(10, 8)
  longitude       Decimal?  @db.Decimal(11, 8)
  maxGuests       Int       @map("max_guests")
  bedrooms        Int       @default(0)
  beds            Int       @default(0)
  bathrooms       Decimal   @default(1.0) @db.Decimal(3, 1)
  pricePerNight   Decimal   @map("price_per_night") @db.Decimal(10, 2)
  cleaningFee     Decimal   @default(0) @map("cleaning_fee") @db.Decimal(10, 2)
  currency        String    @default("EUR") @db.Char(3)
  amenities       Json      @default("{}") @db.JsonB
  houseRules      Json      @default("{}") @map("house_rules") @db.JsonB
  isActive        Boolean   @default(true) @map("is_active")
  instantBooking  Boolean   @default(false) @map("instant_booking")
  viewCount       Int       @default(0) @map("view_count")
  bookingCount    Int       @default(0) @map("booking_count")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  host            User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  images          PropertyImage[]
  bookings        Booking[]
  reviews         Review[]
  messages        Message[]
  favorites       Favorite[]
  calendarPricing CalendarPricing[]

  @@index([hostId])
  @@index([city, country])
  @@index([pricePerNight])
  @@index([isActive])
  @@map("properties")
}

// ==========================================
// 6. PROPERTY_IMAGES
// ==========================================
model PropertyImage {
  id           Int      @id @default(autoincrement())
  propertyId   Int      @map("property_id")
  imageUrl     String   @map("image_url") @db.VarChar(255)
  minioKey     String?  @map("minio_key") @db.VarChar(255)
  isCover      Boolean  @default(false) @map("is_cover")
  displayOrder Int      @default(0) @map("display_order")
  uploadedAt   DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([propertyId, isCover])
  @@map("property_images")
}

// ==========================================
// 7. BOOKINGS
// ==========================================
model Booking {
  id                  Int       @id @default(autoincrement())
  propertyId          Int       @map("property_id")
  guestId             Int       @map("guest_id")
  checkInDate         DateTime  @map("check_in_date") @db.Date
  checkOutDate        DateTime  @map("check_out_date") @db.Date
  numberOfGuests      Int       @map("number_of_guests")
  pricePerNight       Decimal   @map("price_per_night") @db.Decimal(10, 2)
  cleaningFee         Decimal   @default(0) @map("cleaning_fee") @db.Decimal(10, 2)
  totalPrice          Decimal   @map("total_price") @db.Decimal(10, 2)
  status              String    @default("pending") @db.VarChar(50)
  paymentStatus       String    @default("pending") @map("payment_status") @db.VarChar(50)
  paymentMethod       String?   @map("payment_method") @db.VarChar(50)
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason  String?   @map("cancellation_reason") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  property            Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guest               User      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  payment             Payment?
  review              Review?
  messages            Message[]

  @@index([propertyId])
  @@index([guestId])
  @@index([checkInDate, checkOutDate])
  @@index([status])
  @@map("bookings")
}

// ==========================================
// 8. PAYMENTS
// ==========================================
model Payment {
  id                Int       @id @default(autoincrement())
  bookingId         Int       @unique @map("booking_id")
  amount            Decimal   @db.Decimal(10, 2)
  currency          String    @default("EUR") @db.Char(3)
  paymentMethod     String?   @map("payment_method") @db.VarChar(50)
  status            String    @default("pending") @db.VarChar(50)
  stripePaymentId   String?   @map("stripe_payment_id") @db.VarChar(255)
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("payments")
}

// ==========================================
// 9. REVIEWS
// ==========================================
model Review {
  id                    Int       @id @default(autoincrement())
  bookingId             Int       @unique @map("booking_id")
  propertyId            Int       @map("property_id")
  authorId              Int       @map("author_id")
  rating                Int
  comment               String?   @db.Text
  cleanlinessRating     Int?      @map("cleanliness_rating")
  accuracyRating        Int?      @map("accuracy_rating")
  communicationRating   Int?      @map("communication_rating")
  locationRating        Int?      @map("location_rating")
  valueRating           Int?      @map("value_rating")
  hostResponse          String?   @map("host_response") @db.Text
  hostResponseAt        DateTime? @map("host_response_at") @db.Timestamptz(6)
  isPublic              Boolean   @default(true) @map("is_public")
  isFlagged             Boolean   @default(false) @map("is_flagged")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  booking               Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  property              Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  author                User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([authorId])
  @@index([bookingId])
  @@map("reviews")
}

// ==========================================
// 10. MESSAGES
// ==========================================
model Message {
  id           Int       @id @default(autoincrement())
  senderId     Int       @map("sender_id")
  recipientId  Int       @map("recipient_id")
  bookingId    Int?      @map("booking_id")
  propertyId   Int?      @map("property_id")
  content      String    @db.Text
  readAt       DateTime? @map("read_at") @db.Timestamptz(6)
  isAutomated  Boolean   @default(false) @map("is_automated")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  sender       User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient    User      @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  booking      Booking?  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  property     Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([recipientId])
  @@index([bookingId])
  @@index([senderId, recipientId, createdAt])
  @@map("messages")
}

// ==========================================
// 11. FAVORITES
// ==========================================
model Favorite {
  userId      Int      @map("user_id")
  propertyId  Int      @map("property_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@map("favorites")
}

// ==========================================
// 12. CALENDAR_PRICING (BONUS)
// ==========================================
model CalendarPricing {
  id              Int      @id @default(autoincrement())
  propertyId      Int      @map("property_id")
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime @map("end_date") @db.Date
  priceOverride   Decimal? @map("price_override") @db.Decimal(10, 2)
  modifierFactor  Decimal? @map("modifier_factor") @db.Decimal(3, 2)
  isAvailable     Boolean  @default(true) @map("is_available")
  reason          String?  @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([startDate, endDate])
  @@map("calendar_pricing")
}